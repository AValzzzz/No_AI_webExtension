{
  "manifest_version": 3,
  "name": "No AI",
  "version": "1.0",
  "description": "Retire -ai aux recherches Google.",
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.google.com/search*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
{
  "manifest_version": 3,
  "name": "No AI",
  "version": "1.0",
  "description": "A firefox extension to remove the AI summary.",
  "browser_specific_settings": {
    "gecko": {
      "id": "No-AI@AValz",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "icons": {
    "512": "logo.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.google.com/search*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}